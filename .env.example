# ==============================================================================
#  my_wallet_bot — environment configuration
# ==============================================================================
#  Copy to `.env` and fill in.  NEVER commit `.env`.
#
#  Two classes of variable:
#    * NEXT_PUBLIC_*  -> inlined into the browser bundle. PUBLIC. Non-secret only.
#    * everything else -> SERVER ONLY. Never referenced from client components.
#
#  A build-time guard (`apps/web/src/env.ts`) throws if a server-only variable is
#  read from client code, and `scripts/check-env-leaks.mjs` scans the built
#  bundle for secret values.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development

# development | staging | production
# `development` forces SAFE MODE: no real chain sends, mock providers allowed.
APP_ENV=development

# Public origin of the Mini App. Must be https:// in production (Telegram requires it).
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
# Telegram Mini App requests come from the Mini App origin itself.
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info
# Emit human-readable logs instead of JSON (development only).
LOG_PRETTY=true


# ------------------------------------------------------------------------------
# 2. DATABASE (Supabase Postgres)   [SERVER ONLY]
# ------------------------------------------------------------------------------
# Use the *session pooler* / direct connection string from Supabase.
# The app connects as a least-privilege role (`app_user`) that is subject to RLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet

# Separate privileged URL used ONLY by the migration CLI. Never used at runtime.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/wallet

# Require TLS to the database. Keep `true` for Supabase.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=8000

# Supabase project details. The service-role key is only needed if you use
# Supabase Storage for attachments; it must NEVER reach the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The anon key is safe to expose but this app does not use client-side Supabase
# at all (see docs/security.md), so it is intentionally left out of the bundle.
SUPABASE_ANON_KEY=


# ------------------------------------------------------------------------------
# 3. TELEGRAM   [SERVER ONLY]
# ------------------------------------------------------------------------------
# From @BotFather. This is a bearer credential — treat it like a password.
TELEGRAM_BOT_TOKEN=

# Bot username without @, used to build deep links.
TELEGRAM_BOT_USERNAME=

# URL of the Mini App as registered with BotFather (usually the same as APP_URL).
TELEGRAM_WEBAPP_URL=http://localhost:3000

# Numeric Telegram user id(s) of the owner/admin(s), comma separated.
# The FIRST id listed is bootstrapped as admin on first login.
TELEGRAM_ADMIN_IDS=

# `polling` (local dev) or `webhook` (production).
TELEGRAM_MODE=polling

# Public HTTPS URL Telegram will POST updates to when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_URL=

# Random 64+ char secret sent by Telegram as X-Telegram-Bot-Api-Secret-Token.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Max age (seconds) of initData accepted by the auth endpoint. Replay protection.
TELEGRAM_INITDATA_MAX_AGE_SECONDS=900


# ------------------------------------------------------------------------------
# 4. APPLICATION CRYPTOGRAPHY   [SERVER ONLY]
# ------------------------------------------------------------------------------
# 32-byte key, base64. Signs session tokens.  openssl rand -base64 32
SESSION_SECRET=

# Session lifetime. Short by design — the Mini App silently re-authenticates
# from initData, so there is no long-lived ambient credential to steal.
SESSION_TTL_SECONDS=3600

# 32-byte key, base64. AES-256-GCM data-encryption key for encrypted columns.
# Rotate via ENCRYPTION_KEY_PREVIOUS (see docs/security.md).
# openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
ENCRYPTION_KEY_PREVIOUS=

# Pepper mixed into PIN hashes (scrypt). openssl rand -base64 32
PIN_PEPPER=


# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN PROVIDERS   [SERVER ONLY]
# ------------------------------------------------------------------------------
# mainnet | testnet.  `testnet` is strongly recommended until you have verified
# the whole pipeline end to end.
CHAIN_ENV=testnet

# --- TRON ---
# TronGrid (primary). Free tier works; a key raises rate limits.
# https://www.trongrid.io/
TRONGRID_API_KEY=
TRON_MAINNET_API_URL=https://api.trongrid.io
TRON_TESTNET_API_URL=https://api.shasta.trongrid.io

# TronScan (fallback indexer). Optional key.
TRONSCAN_API_KEY=
TRON_MAINNET_SCAN_API_URL=https://apilist.tronscanapi.com
TRON_TESTNET_SCAN_API_URL=https://shastapi.tronscan.org

# --- TON ---
# TON Center (primary). Get a free key from @tonapibot on Telegram.
TONCENTER_API_KEY=
TON_MAINNET_API_URL=https://toncenter.com/api/v2
TON_TESTNET_API_URL=https://testnet.toncenter.com/api/v2

# TonAPI (fallback indexer). https://tonconsole.com/
TONAPI_KEY=
TON_MAINNET_TONAPI_URL=https://tonapi.io
TON_TESTNET_TONAPI_URL=https://testnet.tonapi.io

# --- EVM: BNB Smart Chain (BEP-20) ---
# Optional. Both chains have a working public RPC default, so a fresh deployment needs
# nothing here. Set these to use your own node or a paid provider (QuickNode, Ankr, ...),
# which is strongly recommended for mainnet — public endpoints are rate limited and cap
# eth_getLogs ranges.
BSC_MAINNET_RPC_URL=
BSC_TESTNET_RPC_URL=
# Confirmations before a BSC transaction is treated as final. Default: 15 mainnet, 6 testnet.
BSC_CONFIRMATIONS=

# Use in-memory deterministic fake chain data. Forced on when APP_ENV=development
# and no provider keys are configured.
BLOCKCHAIN_MOCK=true

# Confirmations required before a transaction is considered final.
TRON_CONFIRMATIONS=19
TON_CONFIRMATIONS=1

# Outbound HTTP guard rails for provider calls (SSRF protection).
HTTP_TIMEOUT_MS=8000
HTTP_MAX_RESPONSE_BYTES=2097152


# ------------------------------------------------------------------------------
# 6. MARKET DATA   [SERVER ONLY]
# ------------------------------------------------------------------------------
# USD <-> ILS. Both defaults are keyless.
FX_PRIMARY_PROVIDER=frankfurter
FX_FALLBACK_PROVIDER=erapi
FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
ERAPI_URL=https://open.er-api.com/v6
EXCHANGE_RATE_API_KEY=

# Crypto spot prices (USD).
CRYPTO_PRICE_PRIMARY_PROVIDER=coingecko
CRYPTO_PRICE_FALLBACK_PROVIDER=binance
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
BINANCE_API_URL=https://api.binance.com

# How long a cached rate stays authoritative, and how stale it may get before
# the app refuses to report converted values (never silently use a bad rate).
FX_REFRESH_SECONDS=900
FX_MAX_STALENESS_SECONDS=86400
PRICE_REFRESH_SECONDS=300
PRICE_MAX_STALENESS_SECONDS=3600

# Sanity bounds — a fetched USD/ILS rate outside this band is rejected.
FX_USD_ILS_MIN=2.0
FX_USD_ILS_MAX=6.0


# ------------------------------------------------------------------------------
# 7. WORKER / QUEUE   [SERVER ONLY]
# ------------------------------------------------------------------------------
# The job queue is Postgres-backed (SELECT ... FOR UPDATE SKIP LOCKED) so that
# jobs commit atomically with the financial rows they create. See
# docs/architecture.md ("Why not Redis/BullMQ").
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_TIMEOUT_MS=60000
WORKER_HEALTH_PORT=8080

# Wallet scan cadence (seconds).
CHAIN_SCAN_INTERVAL_SECONDS=60

# OPTIONAL: Redis. If set, used for distributed rate limiting and caching only.
# The queue does not require it.
REDIS_URL=


# ------------------------------------------------------------------------------
# 8. RATE LIMITING   [SERVER ONLY]
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_SEND_PER_HOUR=10
RATE_LIMIT_MAX_BODY_BYTES=65536


# ------------------------------------------------------------------------------
# 9. OUTGOING TRANSFERS / SIGNER   [SERVER ONLY]
# ------------------------------------------------------------------------------
#  DANGER ZONE. Everything here is OFF by default and the system is fully
#  functional (watch-only portfolio + notifications) with it off.
#  Read docs/security.md §"Signing architecture" before changing anything.
# ------------------------------------------------------------------------------

# Master kill switch for ALL outgoing crypto transfers. `false` => the API
# refuses every send, including scheduled payments.
SENDING_ENABLED=false

# mock | remote
#   mock   -> transactions are simulated, nothing is broadcast. Always safe.
#   remote -> calls the isolated signer service (apps/signer).
SIGNER_MODE=mock

# Internal URL of the signer service. MUST NOT be publicly routable.
SIGNER_URL=http://127.0.0.1:8090

# Shared secret for HMAC request signing between API/worker and the signer.
# openssl rand -base64 48
SIGNER_HMAC_SECRET=

# Signer-side only. 32-byte base64 key that decrypts stored key material.
# Set ONLY in the signer service environment, never in web/bot/worker.
SIGNER_MASTER_KEY=
SIGNER_PORT=8090
SIGNER_BIND=127.0.0.1

# Signer-side only. Which networks this signer will sign for, and on which chain.
# EVM key generation (POST /generate) is refused for any network not listed here.
SIGNER_ENABLED=false
SIGNER_ALLOWED_NETWORKS=bsc
SIGNER_CHAIN_ENV=testnet
SIGNER_KEYSTORE_PATH=./.signer/keystore.json
# Optional recipient allow-list. When set, the signer refuses every other destination.
SIGNER_ALLOWED_RECIPIENTS=
SIGNER_MAX_USD_PER_TX=100
SIGNER_MAX_USD_PER_DAY=250
# Refuses to start bound to 0.0.0.0 without this. Needed on Railway's private network.
SIGNER_ALLOW_PUBLIC_BIND=false

# Spend guard rails, enforced independently on both API and signer.
SEND_MAX_USD_PER_TX=250
SEND_MAX_USD_PER_DAY=1000
SEND_REQUIRE_PIN=true
SEND_CONFIRM_TTL_SECONDS=180


# ------------------------------------------------------------------------------
# 10. PUBLIC (browser) VARIABLES — non-secret by definition
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Wallet
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar
NEXT_PUBLIC_CHAIN_ENV=testnet
# Purely cosmetic: shows a "TEST MODE" banner in the UI.
NEXT_PUBLIC_SAFE_MODE_BANNER=true

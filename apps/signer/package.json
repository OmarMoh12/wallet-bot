  "dependencies": {
    "@noble/curves": "1.8.1",
    "@wallet/shared": "workspace:*",
    "zod": "3.24.1",
    "@wallet/blockchain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}

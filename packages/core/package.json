    "@wallet/telegram": "workspace:*",
    "pino": "9.6.0",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/qrcode": "1.5.5",
    "typescript": "5.7.3"
  }

{
  "name": "@wallet/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wallet/shared": "workspace:*",
    "postgres": "3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "typescript": "5.7.3"
  }
}
